{
  "coreName": "Stella",
  "systemId": "A26",
  "author": "The Stella Team",
  "url": "https://stella-emu.github.io",
  "romFile": "rom",
  "deterministic": true,
  "memoryLayoutMiB": [
    4,
    4,
    4,
    16,
    16
  ],
  "_memoryLayoutMiB_note": "sbrk, sealed, invisible, plain, mmap. The 2600 itself is tiny; the room is for Stella's own C++ machinery (property database, cartridge autodetection) and the ARM-cartridge emulation some later carts need.",
  "video": {
    "_comment": "buffer CAPACITY; the live size comes from GetVideoWidth/Height per frame. A 2600 draws 160 pixels across and as many lines as the program cares to (192 on an NTSC machine, up to 312 on a PAL one). Virtual dims are the 4:3 picture those 160 pixels are stretched to.",
    "width": 160,
    "height": 312,
    "virtualWidth": 440,
    "virtualHeight": 312,
    "vsyncNumerator": 60,
    "vsyncDenominator": 1,
    "getBgra": "GetVideoBgra"
  },
  "audio": {
    "samplesPerFrame": 1024,
    "channels": 2,
    "get": "GetAudio"
  },
  "lag": {
    "inputWasRead": "InputWasRead"
  },
  "extensions": {
    ".a26": "A26",
    ".bin": "A26"
  },
  "input": {
    "name": "Atari 2600 Controller",
    "_comment": "The console's own switches come first - they are inputs on a 2600, not menu items - then the two ports. Difficulty and TV type are LEVELS: held is A / colour, released is B / black-and-white, which is how the switches sit on the machine.",
    "buttons": [
      "Power",
      "Reset",
      "Select",
      "Toggle Left Difficulty",
      "Toggle Right Difficulty",
      "Toggle TV Type",
      "P1 Up",
      "P1 Down",
      "P1 Left",
      "P1 Right",
      "P1 Button",
      "P2 Up",
      "P2 Down",
      "P2 Left",
      "P2 Right",
      "P2 Button"
    ]
  },
  "settings": [
    {
      "name": "port1",
      "display": "Port 1 Device",
      "type": "enum",
      "options": [
        "joystick",
        "none",
        "driving"
      ],
      "default": "joystick",
      "description": "What is plugged into the left controller port."
    },
    {
      "name": "port2",
      "display": "Port 2 Device",
      "type": "enum",
      "options": [
        "joystick",
        "none",
        "driving"
      ],
      "default": "joystick",
      "description": "What is plugged into the right controller port."
    },
    {
      "name": "format",
      "display": "Television Format",
      "type": "enum",
      "options": [
        "AUTO",
        "NTSC",
        "PAL",
        "SECAM",
        "NTSC50",
        "PAL60",
        "SECAM60"
      ],
      "default": "AUTO",
      "description": "Which television this machine is wired for. AUTO takes the cartridge's own word for it, which is what a 2600 does; forcing it is how a program written for one region is run on the other, and it changes the frame rate, so it is part of the machine."
    },
    {
      "name": "randomSeed",
      "display": "Power-on Seed",
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 2147483647,
      "description": "What the machine wakes up with. A real 2600's RAM holds whatever was there and its timer is wherever it stopped; Stella models that with a random generator, which would make every session a different machine. This pins it, so the same project is the same machine every time - and a movie records the number it ran with."
    }
  ],
  "firmware": []
}
