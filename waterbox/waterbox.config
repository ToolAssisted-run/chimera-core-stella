{
  "coreName": "Stella",
  "systemId": "A26",
  "systemNames": {
    "A26": "Atari 2600"
  },
  "author": "The Stella Team",
  "url": "https://stella-emu.github.io",
  "romFile": "rom",
  "deterministic": true,
  "memoryLayoutMiB": [
    4,
    4,
    4,
    16,
    16
  ],
  "_memoryLayoutMiB_note": "sbrk, sealed, invisible, plain, mmap. The 2600 itself is tiny; the room is for Stella's own C++ machinery (property database, cartridge autodetection) and the ARM-cartridge emulation some later carts need.",
  "video": {
    "_comment": "buffer CAPACITY; the live size comes from GetVideoWidth/Height per frame. A 2600 draws 160 pixels across and as many lines as the program cares to (192 on an NTSC machine, up to 312 on a PAL one). Virtual dims are the 4:3 picture those 160 pixels are stretched to.",
    "width": 160,
    "height": 312,
    "virtualWidth": 440,
    "virtualHeight": 312,
    "vsyncNumerator": 60,
    "vsyncDenominator": 1,
    "_vsync_note": "Round on purpose, and the only core here that is: a 2600 has no fixed refresh rate, because the PROGRAM decides how many scanlines a frame is. A cartridge emitting the conventional 262 NTSC lines runs at 59.9227Hz and one emitting 261 does not. This is what the standard asks for; see cinterface.cpp for why it is not swapped for a more precise constant that would be just as wrong.",
    "getBgra": "GetVideoBgra"
  },
  "audio": {
    "samplesPerFrame": 1024,
    "channels": 2,
    "get": "GetAudio"
  },
  "lag": {
    "inputWasRead": "InputWasRead"
  },
  "extensions": {
    ".a26": "A26",
    ".bin": "A26"
  },
  "input": {
    "name": "Atari 2600 Controller",
    "_comment": "The console's own switches come first - they are inputs on a 2600, not menu items - then the two ports. Difficulty and TV type are LEVELS: held is A / colour, released is B / black-and-white, which is how the switches sit on the machine.",
    "buttons": [
      "Power",
      "Reset",
      "Select",
      "Toggle Left Difficulty",
      "Toggle Right Difficulty",
      "Toggle TV Type",
      "P1 Up",
      "P1 Down",
      "P1 Left",
      "P1 Right",
      "P1 Button",
      "P2 Up",
      "P2 Down",
      "P2 Left",
      "P2 Right",
      "P2 Button"
    ],
    "mnemonics": {
      "Power": "P",
      "Reset": "r",
      "Select": "s",
      "Toggle Left Difficulty": "x",
      "Toggle Right Difficulty": "y",
      "Toggle TV Type": "V",
      "Up": "U",
      "Down": "D",
      "Left": "L",
      "Right": "R",
      "Button": "B"
    }
  },
  "settings": [
    {
      "name": "port1",
      "display": "Port 1 Device",
      "type": "enum",
      "options": [
        "joystick",
        "none",
        "driving"
      ],
      "default": "joystick",
      "description": "What is plugged into the left controller port."
    },
    {
      "name": "port2",
      "display": "Port 2 Device",
      "type": "enum",
      "options": [
        "joystick",
        "none",
        "driving"
      ],
      "default": "joystick",
      "description": "What is plugged into the right controller port."
    },
    {
      "name": "format",
      "display": "Television Format",
      "type": "enum",
      "options": [
        "AUTO",
        "NTSC",
        "PAL",
        "SECAM",
        "NTSC50",
        "PAL60",
        "SECAM60"
      ],
      "default": "AUTO",
      "description": "Which television standard the console is built for. AUTO uses what the cartridge says, as a real 2600 does. Choosing one by hand lets a game made for one region run on the other. It changes the frame rate, so a movie needs the same value."
    },
    {
      "name": "randomSeed",
      "display": "Power-on Seed",
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 2147483647,
      "description": "The number that decides what the machine's memory and timer hold when it is switched on. On a real 2600 they hold whatever was left there. Stella imitates that with random values, which would make every session start differently. With this number fixed, the same project always starts the same way, and a movie records the number it used."
    }
  ],
  "firmware": []
}
