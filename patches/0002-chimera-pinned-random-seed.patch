diff --git a/src/emucore/Console.cxx b/src/emucore/Console.cxx
index a69ca4b7c..1b5a2f922 100644
--- a/src/emucore/Console.cxx
+++ b/src/emucore/Console.cxx
@@ -72,6 +72,12 @@
 
 #include "Console.hxx"
 
+/* chimera: 1 and *seed set when the host pins the machine's random seed
+ * (see the comment at its use below); weakly defined so a build without a
+ * host - upstream's own - keeps the clock. */
+extern "C" int chimera_pinned_random_seed(uInt32* seed) __attribute__((weak));
+extern "C" int chimera_pinned_random_seed(uInt32* seed) { (void)seed; return 0; }
+
 namespace {
   // Emulation speed is a positive float that multiplies the framerate. However,
   // the UI controls adjust speed in terms of a speedup factor (1/10,
@@ -138,7 +144,17 @@ Console::Console(OSystem& osystem, unique_ptr<Cartridge>& cart,
   myOSystem.sound().stopWav();
 
   // Reinitialize the RNG
-  myOSystem.random().initSeed(static_cast<uInt32>(TimerManager::getTicks()));
+  //
+  // chimera: a machine seeded from the wall clock is a DIFFERENT MACHINE every
+  // time it is powered on - the RAM it wakes with, the point the RIOT timer is
+  // at - and a movie recorded on one would not replay on another. A host that
+  // needs the machine to be a function of its project (rather than of the
+  // moment) pins the seed here; everyone else keeps the clock.
+  uInt32 chimeraSeed = 0;
+  if(chimera_pinned_random_seed(&chimeraSeed))
+    myOSystem.random().initSeed(chimeraSeed);
+  else
+    myOSystem.random().initSeed(static_cast<uInt32>(TimerManager::getTicks()));
 
   // Construct the system and components
   mySystem = std::make_unique<System>(myOSystem.random(), *my6502, *myRiot, *myTIA, *myCart);
